{
  "info": {
    "name": "social-media-app-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "socketUrl", "value": "ws://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "confirmToken", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "resendToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "storyId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "chatId", "value": "" },
    { "key": "groupId", "value": "" },
    { "key": "messageId", "value": "" }
  ],
  "item": [
    { "name": "Landing", "request": { "method": "GET", "url": "{{baseUrl}}/" } },
    { "name": "Auth Route", "request": { "method": "GET", "url": "{{baseUrl}}/auth" } },
    {
      "name": "Auth",
      "item": [
        { "name": "Signup", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"username\":\"johndoe\",\"email\":\"john@example.com\",\"password\":\"Password123!\",\"confirmPassword\":\"Password123!\"}" }, "url": "{{baseUrl}}/auth/signup" } },
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"john@example.com\",\"password\":\"Password123!\"}" }, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Confirm Email", "request": { "method": "GET", "url": "{{baseUrl}}/auth/confirm?token={{confirmToken}}" } },
        { "name": "Resend Confirmation", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"john@example.com\"}" }, "url": "{{baseUrl}}/auth/resend-confirmation" } },
        { "name": "Forgot Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"john@example.com\"}" }, "url": "{{baseUrl}}/auth/forgot-password" } },
        { "name": "Reset Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"token\":\"{{resetToken}}\",\"newPassword\":\"NewPassword123!\"}" }, "url": "{{baseUrl}}/auth/reset-password" } },
        { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }, "url": "{{baseUrl}}/auth/logout" } },
        { "name": "Social Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"john@example.com\",\"username\":\"johndoe\",\"provider\":\"google\",\"picture\":\"https://example.com/avatar.png\"}" }, "url": "{{baseUrl}}/auth/social-login" } }
      ]
    },
    {
      "name": "GraphQL",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": { "mode": "raw", "raw": "{\"query\":\"query { me { id username } chats { id participants { id username } } groups { id name } }\"}" },
        "url": "{{baseUrl}}/graphql"
      }
    },
    {
      "name": "Users",
      "item": [
        { "name": "Get Users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/users" } },
        { "name": "Get User", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "Get My Profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/users/me/profile" } },
        { "name": "Update User", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"username\":\"updated-name\"}" }, "url": "{{baseUrl}}/users/{{userId}}" } },
        { "name": "Update FCM Token", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"fcmToken\":\"device-token\"}" }, "url": "{{baseUrl}}/users/me/fcm-token" } },
        { "name": "Delete User", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/users/{{userId}}" } }
      ]
    },
    {
      "name": "Posts",
      "item": [
        { "name": "Create Post", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"content\":\"Hello from the social app\",\"privacy\":\"public\"}" }, "url": "{{baseUrl}}/posts" } },
        { "name": "Get Feed", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/posts?limit=20" } },
        { "name": "Get Profile Posts", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/posts/profile/{{userId}}" } },
        { "name": "Get Post", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/posts/{{postId}}" } },
        { "name": "Update Post", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"content\":\"Updated post\"}" }, "url": "{{baseUrl}}/posts/{{postId}}" } },
        { "name": "Delete Post", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/posts/{{postId}}" } },
        { "name": "React To Post", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"emoji\":\"👍\"}" }, "url": "{{baseUrl}}/posts/{{postId}}/reactions" } },
        { "name": "Admin Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/posts/dashboard" } }
      ]
    },
    {
      "name": "Comments",
      "item": [
        { "name": "Create Comment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"text\":\"Nice post\"}" }, "url": "{{baseUrl}}/posts/{{postId}}/comments" } },
        { "name": "Get Comments", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/posts/{{postId}}/comments" } },
        { "name": "Update Comment", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"text\":\"Updated comment\"}" }, "url": "{{baseUrl}}/comments/{{commentId}}" } },
        { "name": "Delete Comment", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/comments/{{commentId}}" } },
        { "name": "React To Comment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"emoji\":\"❤️\"}" }, "url": "{{baseUrl}}/comments/{{commentId}}/reactions" } }
      ]
    },
    {
      "name": "Stories",
      "item": [
        { "name": "Create Story", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"mediaUrl\":\"https://example.com/story.jpg\",\"type\":\"image\",\"caption\":\"Today\"}" }, "url": "{{baseUrl}}/stories" } },
        { "name": "Get Active Stories", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/stories" } },
        { "name": "Get User Stories", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/stories/user/{{userId}}" } },
        { "name": "Update Story", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"caption\":\"Updated\"}" }, "url": "{{baseUrl}}/stories/{{storyId}}" } },
        { "name": "Delete Story", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/stories/{{storyId}}" } }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "Create Notification", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"title\":\"Announcement\",\"message\":\"Welcome\",\"recipientIds\":[],\"sendPush\":false}" }, "url": "{{baseUrl}}/notifications" } },
        { "name": "Get My Notifications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/notifications" } },
        { "name": "Get All Notifications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/notifications/admin/all" } },
        { "name": "Update Notification", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"message\":\"Updated announcement\"}" }, "url": "{{baseUrl}}/notifications/{{notificationId}}" } },
        { "name": "Mark Notification Read", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/notifications/{{notificationId}}/read" } },
        { "name": "Delete Notification", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/notifications/{{notificationId}}" } }
      ]
    },
    {
      "name": "Chats",
      "item": [
        { "name": "Create Or Get Chat", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/chats/{{userId}}" } },
        { "name": "Get User Chats", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/chats" } },
        { "name": "Get Chat Messages", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/chats/{{chatId}}/messages" } },
        { "name": "Send Message", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"content\":\"Hello\"}" }, "url": "{{baseUrl}}/chats/{{chatId}}/messages" } }
      ]
    },
    {
      "name": "Groups",
      "item": [
        { "name": "Create Group", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Project Team\",\"memberIds\":[\"{{userId}}\"]}" }, "url": "{{baseUrl}}/groups" } },
        { "name": "Get User Groups", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/groups" } },
        { "name": "Get Group Messages", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/groups/{{groupId}}/messages" } },
        { "name": "Send Group Message", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"content\":\"Group update\"}" }, "url": "{{baseUrl}}/groups/{{groupId}}/messages" } }
      ]
    },
    {
      "name": "Socket.IO",
      "request": {
        "method": "GET",
        "description": "Connect with Socket.IO using auth.token={{accessToken}}. Events: chat:join {chatId}, chat:send {chatId,content}, group:join {groupId}, group:send {groupId,content}, chat:typing {chatId,isTyping}, group:typing {groupId,isTyping}. Listen for message:new, group_message:new, notification:new_message, notification:new_group_message.",
        "url": "{{socketUrl}}/socket.io/?EIO=4&transport=websocket"
      }
    },
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }
  ]
}
