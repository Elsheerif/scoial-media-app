{
  "info": {
    "name": "social-media-app-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "confirmToken", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "resendToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "storyId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "fcmToken", "value": "" }
  ],
  "item": [
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
        },
        "url": { "raw": "http://localhost:3000/auth/signup", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth","signup"] }
      },
      "response": [
        {
          "name": "Signup success",
          "originalRequest": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
            },
            "url": "http://localhost:3000/auth/signup"
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"User created successfully\",\n  \"result\": {\n    \"user\": {\n      \"username\": \"johndoe\",\n      \"email\": \"john@example.com\",\n      \"provider\": \"local\",\n      \"confirmEmail\": false,\n      \"role\": \"USER\"\n    },\n    \"confirmToken\": \"{{confirmToken}}\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\"\n}" },
        "url": { "raw": "http://localhost:3000/auth/login", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth","login"] }
      },
      "response": [
        {
          "name": "Login success",
          "originalRequest": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\"\n}" },
            "url": "http://localhost:3000/auth/login"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"User logged in successfully\",\n  \"result\": {\n    \"user\": {\n      \"email\": \"john@example.com\",\n      \"confirmEmail\": true\n    },\n    \"access_token\": \"{{accessToken}}\",\n    \"refresh_token\": \"{{refreshToken}}\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Confirm Email",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:3000/auth/confirm?token={{confirmToken}}", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth","confirm"], "query": [{"key":"token","value":"{{confirmToken}}"}] }
      },
      "response": [
        {
          "name": "Confirm success",
          "originalRequest": { "method": "GET", "url": "http://localhost:3000/auth/confirm?token={{confirmToken}}" },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Email confirmed\"\n}"
        }
      ]
    },
    {
      "name": "Resend Confirmation",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\"\n}" },
        "url": { "raw": "http://localhost:3000/auth/resend-confirmation", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth","resend-confirmation"] }
      },
      "response": [
        {
          "name": "Resend confirmation success",
          "originalRequest": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\"\n}" },
            "url": "http://localhost:3000/auth/resend-confirmation"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Confirmation email sent\",\n  \"result\": {\n    \"resendToken\": \"{{resendToken}}\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\"\n}" },
        "url": { "raw": "http://localhost:3000/auth/forgot-password", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth","forgot-password"] }
      },
      "response": [
        {
          "name": "Forgot password success",
          "originalRequest": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\"\n}" },
            "url": "http://localhost:3000/auth/forgot-password"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Password reset email sent\",\n  \"result\": {\n    \"resetToken\": \"{{resetToken}}\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword123!\"\n}" },
        "url": { "raw": "http://localhost:3000/auth/reset-password", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth","reset-password"] }
      },
      "response": [
        {
          "name": "Reset password success",
          "originalRequest": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword123!\"\n}" },
            "url": "http://localhost:3000/auth/reset-password"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Password updated\"\n}"
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": { "raw": "http://localhost:3000/auth/logout", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth","logout"] }
      },
      "response": [
        {
          "name": "Logout success",
          "originalRequest": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "http://localhost:3000/auth/logout"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Logged out\"\n}"
        }
      ]
    },
    {
      "name": "Social Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\",\n  \"provider\": \"google\"\n}" },
        "url": { "raw": "http://localhost:3000/auth/social-login", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["auth","social-login"] }
      },
      "response": [
        {
          "name": "Social login success",
          "originalRequest": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\",\n  \"provider\": \"google\"\n}" },
            "url": "http://localhost:3000/auth/social-login"
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"message\": \"Social login success\",\n  \"result\": {\n    \"user\": {\n      \"email\": \"john@example.com\",\n      \"provider\": \"google\"\n    },\n    \"access_token\": \"{{accessToken}}\",\n    \"refresh_token\": \"{{refreshToken}}\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/users" }
        },
        {
          "name": "Get profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/users/me/profile" }
        },
        {
          "name": "Get user by ID",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/users/{{userId}}" }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"john-updated\",\n  \"profilePicture\": \"https://example.com/avatar.jpg\",\n  \"coverPicture\": \"https://example.com/cover.jpg\"\n}" },
            "url": "http://localhost:3000/users/{{userId}}"
          }
        },
        {
          "name": "Update FCM token",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fcmToken\": \"{{fcmToken}}\"\n}" },
            "url": "http://localhost:3000/users/me/fcm-token"
          }
        },
        {
          "name": "Delete user",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/users/{{userId}}" }
        }
      ]
    },
    {
      "name": "Posts and feed",
      "item": [
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Hello from Postman\",\n  \"media\": [],\n  \"privacy\": \"public\"\n}" },
            "url": "http://localhost:3000/posts"
          }
        },
        {
          "name": "Get news feed",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/posts?limit=20" }
        },
        {
          "name": "Get dashboard (admin)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "http://localhost:3000/posts/dashboard" }
        },
        {
          "name": "Get profile posts",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/posts/profile/{{userId}}?limit=30" }
        },
        {
          "name": "Get post",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/posts/{{postId}}" }
        },
        {
          "name": "Update post",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Updated post content\"\n}" },
            "url": "http://localhost:3000/posts/{{postId}}"
          }
        },
        {
          "name": "React to post (toggle/change emoji)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"emoji\": \"❤️\"\n}" },
            "url": "http://localhost:3000/posts/{{postId}}/reactions"
          }
        },
        {
          "name": "Delete post",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/posts/{{postId}}" }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Nice post!\"\n}" },
            "url": "http://localhost:3000/posts/{{postId}}/comments"
          }
        },
        {
          "name": "List comments",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/posts/{{postId}}/comments" }
        },
        {
          "name": "Update comment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Updated comment\"\n}" },
            "url": "http://localhost:3000/comments/{{commentId}}"
          }
        },
        {
          "name": "React to comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"emoji\": \"👍\"\n}" },
            "url": "http://localhost:3000/comments/{{commentId}}/reactions"
          }
        },
        {
          "name": "Delete comment",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/comments/{{commentId}}" }
        }
      ]
    },
    {
      "name": "Stories (24-hour)",
      "item": [
        {
          "name": "Create story",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mediaUrl\": \"https://example.com/story.jpg\",\n  \"type\": \"image\",\n  \"caption\": \"My story\"\n}" },
            "url": "http://localhost:3000/stories"
          }
        },
        {
          "name": "List active stories",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/stories?limit=50" }
        },
        {
          "name": "List user stories",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/stories/user/{{userId}}" }
        },
        {
          "name": "Update story",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"caption\": \"Updated story\"\n}" },
            "url": "http://localhost:3000/stories/{{storyId}}"
          }
        },
        {
          "name": "Delete story",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/stories/{{storyId}}" }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List my notifications",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/notifications" }
        },
        {
          "name": "Mark notification read",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "http://localhost:3000/notifications/{{notificationId}}/read" }
        },
        {
          "name": "Create notification (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Announcement\",\n  \"message\": \"Welcome to the app\",\n  \"type\": \"info\",\n  \"recipientIds\": [\"{{userId}}\"],\n  \"sendPush\": true,\n  \"payload\": { \"screen\": \"home\" }\n}" },
            "url": "http://localhost:3000/notifications"
          }
        },
        {
          "name": "List all notifications (admin)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "http://localhost:3000/notifications/admin/all" }
        },
        {
          "name": "Update notification (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Updated announcement\"\n}" },
            "url": "http://localhost:3000/notifications/{{notificationId}}"
          }
        },
        {
          "name": "Delete notification (admin)",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }], "url": "http://localhost:3000/notifications/{{notificationId}}" }
        }
      ]
    },
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "http://localhost:3000/health" }
    }
  ]
}
